# Copiar a .env (ignorado por Git) y completar. Se carga con python-dotenv.

# Spark 3.5 requiere Java 17 (Java >= 24 rompe el cliente Hadoop).
# macOS con Homebrew:
JAVA_HOME=/opt/homebrew/opt/openjdk@17

# Sal secreta para seudonimizar RUC de personas naturales (prefijo 10).
# Generar una con:  python -c "import secrets; print(secrets.token_hex(32))"
PRECIOJUSTO_SALT=
